{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Renaissance essays manifest",
  "type": "object",
  "required": ["essays"],
  "additionalProperties": false,
  "properties": {
    "essays": {
      "type": "array",
      "items": { "$ref": "#/definitions/essay" }
    }
  },
  "definitions": {
    "essay": {
      "type": "object",
      "required": ["id", "slug", "title", "summary", "source_dir", "section_order", "section_meta", "published"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string" },
        "published_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "social_image": { "type": "string", "minLength": 1 },
        "source_dir": { "type": "string", "minLength": 1 },
        "display": { "type": "object" },
        "section_order": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1 }
        },
        "section_meta": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "patternProperties": {
            "^[0-9]+$": {
              "type": "object",
              "required": ["title"],
              "additionalProperties": false,
              "properties": {
                "title": { "type": "string", "minLength": 1 },
                "subtitle": { "type": "string" }
              }
            }
          }
        },
        "published": { "type": "boolean" }
      },
      "allOf": [
        {
          "$comment": "A published essay must be complete: a publish date and a non-empty summary.",
          "if": { "properties": { "published": { "const": true } }, "required": ["published"] },
          "then": {
            "required": ["published_at"],
            "properties": { "summary": { "type": "string", "minLength": 1 } }
          }
        }
      ]
    }
  }
}
