{
  "name": "renaissance",
  "private": true,
  "version": "1.0.0",
  "description": "Renaissance is a warm, book-style static website for long-form essays.",
  "type": "commonjs",
  "scripts": {
    "dev": "python -m http.server 8000",
    "check": "npm run check:syntax && npm run validate:content && npm run validate:embedded:check",
    "check:syntax": "node scripts/check-js-syntax.js",
    "ci:standalone": "npm run check && npm run test:standalone",
    "ci:regression": "node scripts/ci/run-with-server.js --port 4173 -- npm run test:regression -- --base http://127.0.0.1:4173",
    "ci:visual": "node scripts/ci/run-with-server.js --port 4174 -- npm run visual:check -- --base http://127.0.0.1:4174 --warn-only",
    "ci:lighthouse": "node scripts/ci/run-with-server.js --port 4175 -- node scripts/ci/lighthouse-warning-runner.js --base http://127.0.0.1:4175",
    "test:anchors": "node scripts/tests/anchor-regression.js",
    "test:chapter-redirect": "node scripts/tests/chapter-redirect-regression.js",
    "test:content-fallback": "node scripts/tests/content-fallback-regression.js",
    "test:copy-footer": "node scripts/tests/copy-footer-regression.js",
    "test:hover-preview": "node scripts/tests/hover-preview-regression.js",
    "test:lighthouse-target": "node scripts/tests/lighthouse-target-resolver-regression.js",
    "test:meta": "node scripts/tests/meta-regression.js",
    "test:og-cards": "node scripts/tests/og-card-generation-regression.js",
    "test:reading-state": "node scripts/tests/reading-state-regression.js",
    "test:reduced-motion": "node scripts/tests/reduced-motion-regression.js",
    "test:router": "node scripts/tests/router-regression.js",
    "test:regression": "node scripts/tests/regression-check.js",
    "test:standalone": "npm run test:content-fallback && npm run test:lighthouse-target && npm run test:og-cards",
    "og:generate": "node scripts/og/generate-cards.js",
    "visual:capture": "node scripts/visual/capture.js",
    "visual:diff": "node scripts/visual/diff.js",
    "visual:check": "node scripts/visual/check.js",
    "visual:approve": "node scripts/visual/approve.js",
    "validate:content": "node scripts/validate-content.js",
    "validate:embedded:check": "node scripts/generate-embedded-data.js --check"
  },
  "devDependencies": {
    "pixelmatch": "^7.1.0",
    "playwright": "^1.58.2",
    "pngjs": "^7.0.0"
  }
}
